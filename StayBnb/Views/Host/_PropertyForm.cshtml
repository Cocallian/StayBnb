@model StayBnb.Models.HostProperty
@{
    var amenities = (List<StayBnb.Models.Amenity>)ViewBag.Amenities;
    var selected = (List<int>)ViewBag.SelectedAmenities;
    var image = Model.Images.FirstOrDefault()?.ImageUrl;
}

<div class="form-card" style="max-width: 800px;">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <h3>Details</h3>
        <label asp-for="Title"></label>
        <input asp-for="Title" type="text" />
        <span asp-validation-for="Title" class="text-danger"></span>

        <label asp-for="Description"></label>
        <textarea asp-for="Description" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>

        <div class="two-col">
            <div>
                <label asp-for="Address"></label>
                <input asp-for="Address" type="text" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="City"></label>
                <input asp-for="City" type="text" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>
        </div>

        <h3 style="margin-top: 28px;">Pricing (R)</h3>
        <div class="two-col">
            <div>
                <label asp-for="PricePerNight"></label>
                <input asp-for="PricePerNight" type="number" step="0.01" />
                <span asp-validation-for="PricePerNight" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="CleaningFee"></label>
                <input asp-for="CleaningFee" type="number" step="0.01" />
                <span asp-validation-for="CleaningFee" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="ServiceFee"></label>
                <input asp-for="ServiceFee" type="number" step="0.01" />
                <span asp-validation-for="ServiceFee" class="text-danger"></span>
            </div>
        </div>

        <h3 style="margin-top: 28px;">Photo and amenities</h3>
        <label for="imageUrl">Image URL</label>
        <input id="imageUrl" name="imageUrl" type="text" value="@image" />
        @if (!string.IsNullOrWhiteSpace(image))
        {
            <img src="@image" alt="Current image" style="margin-top: 10px; width: 200px; height: 130px; object-fit: cover; border-radius: 8px;" />
        }

        <label>Amenities</label>
        <div class="amenities">
            @foreach (var a in amenities)
            {
                <label class="check">
                    <input type="checkbox" name="amenityIds" value="@a.Id" checked="@selected.Contains(a.Id)" /> @a.Name
                </label>
            }
        </div>

        <label class="check" style="margin-top: 14px;"><input asp-for="IsActive" type="checkbox" /> Active listing</label>

        <div class="actions" style="margin-top: 24px;">
            <button type="submit">Save</button>
            <a class="btn ghost" asp-action="Properties">Cancel</a>
        </div>
    </form>
</div>
