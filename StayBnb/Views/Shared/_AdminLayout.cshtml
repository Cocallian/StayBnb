@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using StayBnb.Data
@using StayBnb.Models
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Db
@{
    var user = await UserManager.GetUserAsync(User);
    var fullName = user == null ? "" : $"{user.FirstName} {user.LastName}".Trim();
    var initial = string.IsNullOrEmpty(fullName) ? "?" : fullName.Substring(0, 1).ToUpper();
    var isSuperAdmin = User.IsInRole(Roles.SuperAdmin);
    var roleLabel = isSuperAdmin ? "Super Administrator" : "Administrator";
    var unread = user == null ? 0 : await Db.Notifications.CountAsync(n => n.UserId == user.Id && !n.IsRead);
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string action) => string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StayBnb Admin</title>
    <style>
        body { margin: 0; font-family: system-ui, sans-serif; color: #222; background: #f7f7f8; }
        a { color: inherit; text-decoration: none; }
        .shell { display: flex; min-height: 100vh; }

        /* Sidebar */
        aside { width: 240px; background: #fff; border-right: 1px solid #eee; padding: 24px 16px; box-sizing: border-box; }
        aside .logo { display: block; color: #ff385c; font-weight: 700; font-size: 1.4rem; padding: 0 12px 24px; }
        aside nav a, aside nav button {
            display: flex; align-items: center; gap: 12px; width: 100%; box-sizing: border-box;
            padding: 12px; margin-bottom: 4px; border: none; background: none; border-radius: 10px;
            font: inherit; font-size: 0.9rem; color: #444; cursor: pointer; text-align: left;
        }
        aside nav a:hover, aside nav button:hover { background: #f5f5f5; }
        aside nav a.active { background: #ffe8ec; color: #ff385c; font-weight: 600; }
        aside nav .logout { color: #ff385c; margin-top: 4px; }
        .badge { margin-left: auto; background: #ff385c; color: #fff; border-radius: 999px; font-size: 0.7rem; padding: 2px 7px; }

        /* Top bar and content */
        .content { flex: 1; min-width: 0; }
        .topbar { display: flex; align-items: center; justify-content: space-between; padding: 20px 32px; background: #fff; border-bottom: 1px solid #eee; }
        .topbar h1 { margin: 0; font-size: 1.3rem; flex: 1; text-align: center; }
        .topbar .right { display: flex; align-items: center; gap: 20px; }
        .topbar .icon { position: relative; font-size: 1.1rem; }
        .topbar .icon .badge { position: absolute; top: -8px; right: -10px; margin: 0; }
        .profile { display: flex; align-items: center; gap: 10px; border: 1px solid #ddd; border-radius: 999px; padding: 6px 14px 6px 8px; }
        .avatar { width: 32px; height: 32px; border-radius: 50%; background: #eee; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; }
        .profile small { display: block; color: #777; font-size: 0.75rem; }
        main { padding: 32px; }

        /* Dashboard cards and table */
        .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 32px; }
        .card { background: #fff; border-radius: 12px; padding: 20px; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06); }
        .card .label { font-size: 0.8rem; color: #666; }
        .card .value { font-size: 1.6rem; font-weight: 700; margin: 6px 0; }
        .card .note { font-size: 0.75rem; color: #198754; }
        .card .value.warn { color: #f08c00; }
        table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 12px; overflow: hidden; }
        th, td { text-align: left; padding: 14px 20px; font-size: 0.85rem; border-bottom: 1px solid #eee; }
        th { color: #777; font-size: 0.75rem; text-transform: uppercase; }
        .status { background: #fff3cd; color: #b8860b; border-radius: 4px; padding: 2px 8px; font-size: 0.75rem; }
    </style>
</head>
<body>
    <div class="shell">
        <aside>
            <a class="logo" asp-controller="Home" asp-action="Index">staybnb</a>
            <nav>
                <a class="@Active("Dashboard")" asp-controller="Admin" asp-action="Dashboard"> Dashboard</a>
                @if (isSuperAdmin)
                {
                    <a class="@Active("Users")" asp-controller="Admin" asp-action="Users"> Users</a>
                }
                <a class="@Active("HostRequests")" asp-controller="Admin" asp-action="HostRequests"> Host Requests</a>
                <a class="@Active("Bookings")" asp-controller="Admin" asp-action="Bookings"> Bookings</a>
                <a class="@Active("Properties")" asp-controller="Admin" asp-action="Properties"> Properties</a>
                <a asp-controller="Admin" asp-action="Messages"> Messages</a>
                <a asp-controller="Admin" asp-action="Notifications">
                     Notifications
                </a>
                <a class="@Active("ActivityLogs")" asp-controller="Admin" asp-action="ActivityLogs"> Activity Logs</a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="logout"> Logout</button>
                </form>
            </nav>
        </aside>

        <div class="content">
            <div class="topbar">
                <h1>@ViewData["Title"]</h1>
                <div class="right">
                    <a class="icon" asp-controller="Admin" asp-action="Messages">&#9993;</a>
                    <a class="icon" asp-controller="Admin" asp-action="Notifications">
                        &#128276;
                        @if (unread > 0) { <span class="badge">@unread</span> }
                    </a>
                    <div class="profile">
                        <div class="avatar">@initial</div>
                        <div>@fullName<small>@roleLabel</small></div>
                    </div>
                </div>
            </div>
            <main>
                @RenderBody()
            </main>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
