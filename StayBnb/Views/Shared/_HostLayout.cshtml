@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using StayBnb.Data
@using StayBnb.Models
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Db
@{
    var user = await UserManager.GetUserAsync(User);
    var fullName = user == null ? "" : $"{user.FirstName} {user.LastName}".Trim();
    var initial = string.IsNullOrEmpty(fullName) ? "?" : fullName.Substring(0, 1).ToUpper();
    var unread = user == null ? 0 : await Db.Notifications.CountAsync(n => n.UserId == user.Id && !n.IsRead);
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(params string[] actions) => actions.Any(a => string.Equals(currentAction, a, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StayBnb Host</title>
    <style>
        body
        {
            margin: 0;
            font-family: system-ui, sans-serif;
            color: #222;
            background: #f7f7f8;
        }
        a
        {
            color: inherit;
            text-decoration: none;
        }
        .shell
        {
            display: flex;
            min-height: 100vh;
        }
        /* Sidebar */
        aside
        {
            width: 240px;
            background: #fff;
            border-right: 1px solid #eee;
            padding: 24px 16px;
            box-sizing: border-box;
        }
        aside .logo
        {
            display: block;
            color: #ff385c;
            font-weight: 700;
            font-size: 1.4rem;
            padding: 0 12px 24px;
        }
        aside nav a, aside nav button
        {
            display: flex;
            align-items: center;
            gap: 12px;
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
            margin-bottom: 4px;
            border: none;
            background: none;
            border-radius: 10px;
            font: inherit;
            font-size: 0.9rem;
            color: #444;
            cursor: pointer;
            text-align: left;
        }
        aside nav a:hover, aside nav button:hover
        {
            background: #f5f5f5;
        }
        aside nav a.active
        {
            background: #ffe8ec;
            color: #ff385c;
            font-weight: 600;
        }
        aside nav .logout
        {
            color: #ff385c;
            margin-top: 4px;
        }
        .badge
        {
            margin-left: auto;
            background: #ff385c;
            color: #fff;
            border-radius: 999px;
            font-size: 0.7rem;
            padding: 2px 7px;
        }
        /* Top bar and content */
        .content
        {
            flex: 1;
            min-width: 0;
        }
        .topbar
        {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 32px;
            background: #fff;
            border-bottom: 1px solid #eee;
        }
        .topbar h1
        {
            margin: 0;
            font-size: 1.3rem;
            flex: 1;
            text-align: center;
        }
        .topbar .right
        {
            display: flex;
            align-items: center;
            gap: 20px;
        }
        .topbar .icon
        {
            position: relative;
            font-size: 1.1rem;
        }
        .topbar .icon .badge
        {
            position: absolute;
            top: -8px;
            right: -10px;
            margin: 0;
        }
        .profile
        {
            display: flex;
            align-items: center;
            gap: 10px;
            border: 1px solid #ddd;
            border-radius: 999px;
            padding: 6px 14px 6px 8px;
        }
        .avatar
        {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #eee;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
        }
        .profile small
        {
            display: block;
            color: #777;
            font-size: 0.75rem;
        }
        main
        {
            padding: 32px;
        }
        /* Dashboard cards and table */
        .cards
        {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 32px;
        }
        .card
        {
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
        }
        .card .label
        {
            font-size: 0.8rem;
            color: #666;
        }
        .card .value
        {
            font-size: 1.6rem;
            font-weight: 700;
            margin: 6px 0;
        }
        .card .note
        {
            font-size: 0.75rem;
            color: #198754;
        }
        .card .value.warn
        {
            color: #f08c00;
        }
        table
        {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
            border-radius: 12px;
            overflow: hidden;
        }
        th, td
        {
            text-align: left;
            padding: 14px 20px;
            font-size: 0.85rem;
            border-bottom: 1px solid #eee;
        }
        th
        {
            color: #777;
            font-size: 0.75rem;
            text-transform: uppercase;
        }
        .status
        {
            background: #fff3cd;
            color: #b8860b;
            border-radius: 4px;
            padding: 2px 8px;
            font-size: 0.75rem;
        }
        .status.ok
        {
            background: #d1e7dd;
            color: #198754;
        }
        .status.bad
        {
            background: #f8d7da;
            color: #b02a37;
        }
        .actions
        {
            display: flex;
            gap: 8px;
        }
        .actions button, .btn
        {
            border: none;
            border-radius: 8px;
            padding: 8px 14px;
            color: #fff;
            font: inherit;
            cursor: pointer;
            background: #ff385c;
            display: inline-block;
        }
        .actions .accept
        {
            background: #198754;
        }
        .actions .deny
        {
            background: #ff385c;
        }
        .property-thumb
        {
            width: 90px;
            height: 60px;
            object-fit: cover;
            border-radius: 6px;
        }
        .form-card
        {
            background: #fff;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
            max-width: 700px;
        }
        .form-card label
        {
            display: block;
            font-size: 0.85rem;
            color: #555;
            margin: 14px 0 4px;
        }
        .form-card input[type=text], .form-card input[type=number], .form-card textarea
        {
            width: 100%;
            box-sizing: border-box;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font: inherit;
        }
        .form-card .check
        {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin: 4px 14px 4px 0;
        }
        .form-card .text-danger
        {
            color: #b02a37;
            font-size: 0.8rem;
        }
        .empty
        {
            color: #777;
            padding: 24px;
            background: #fff;
            border-radius: 12px;
        }
        .toolbar
        {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 16px;
        }
        .page-head
        {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }
        .page-head h3
        {
            margin: 0;
        }
        .page-head p
        {
            margin: 4px 0 0;
            color: #777;
            font-size: 0.85rem;
        }
        .btn:hover, .actions button:hover
        {
            filter: brightness(0.92);
        }
        .btn.ghost
        {
            background: #fff;
            color: #444;
            border: 1px solid #ddd;
        }
        .grid
        {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }
        .prop-card
        {
            background: #fff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
            display: flex;
            flex-direction: column;
        }
        .prop-card .img
        {
            height: 170px;
            background: #eee center / cover no-repeat;
            position: relative;
        }
        .prop-card .img .status
        {
            position: absolute;
            top: 12px;
            left: 12px;
        }
        .prop-card .body
        {
            padding: 16px;
            flex: 1;
        }
        .prop-card h4
        {
            margin: 0 0 4px;
            font-size: 1rem;
        }
        .prop-card .muted, .muted
        {
            color: #777;
            font-size: 0.8rem;
        }
        .prop-card .price
        {
            font-weight: 700;
            margin-top: 10px;
        }
        .prop-card .foot
        {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 16px;
            border-top: 1px solid #eee;
            font-size: 0.85rem;
        }
        .foot a
        {
            color: #ff385c;
            font-weight: 600;
        }
        .stars
        {
            color: #f5a623;
            letter-spacing: 2px;
        }
        .list-card
        {
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
            margin-bottom: 16px;
            display: flex;
            gap: 20px;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
        }
        .list-card .who
        {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 220px;
        }
        .list-card .meta
        {
            display: flex;
            gap: 32px;
            flex-wrap: wrap;
        }
        .list-card .meta div small
        {
            display: block;
            color: #777;
            font-size: 0.72rem;
            text-transform: uppercase;
        }
        .doc-chip
        {
            display: inline-block;
            background: #f5f5f5;
            border-radius: 6px;
            padding: 3px 8px;
            font-size: 0.75rem;
            margin: 2px 4px 2px 0;
        }
        .status.info
        {
            background: #e7f1ff;
            color: #0d6efd;
        }
        .empty
        {
            text-align: center;
            padding: 48px 24px;
        }
        .empty strong
        {
            display: block;
            font-size: 1rem;
            color: #444;
            margin-bottom: 4px;
        }
        .two-col
        {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0 20px;
        }
        .form-card h3
        {
            margin-top: 0;
        }
        .hint
        {
            color: #888;
            font-size: 0.75rem;
            margin-top: 4px;
        }
        .amenities
        {
            display: flex;
            flex-wrap: wrap;
            padding: 6px 0;
        }
        .summary
        {
            display: flex;
            gap: 24px;
            align-items: center;
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 24px;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
        }
        .summary .big
        {
            font-size: 2.2rem;
            font-weight: 700;
        }
        .cards
        {
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        }
        @@media (max-width: 900px)
        {
            .two-col
            {
                grid-template-columns: 1fr;
            }
            aside
            {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="shell">
        <aside>
            <a class="logo" asp-controller="Home" asp-action="Index">staybnb</a>
            <nav>
                <a class="@Active("Dashboard")" asp-controller="Host" asp-action="Dashboard"> Dashboard</a>
                <a class="@Active("Properties", "AddProperty", "EditProperty")" asp-controller="Host" asp-action="Properties"> My Properties</a>
                <a class="@Active("BookingRequests")" asp-controller="Host" asp-action="BookingRequests"> Booking Requests</a>
                <a class="@Active("CheckIns")" asp-controller="Host" asp-action="CheckIns"> Guest Check-Ins</a>
                <a class="@Active("Earnings")" asp-controller="Host" asp-action="Earnings"> Earnings</a>
                <a class="@Active("Reviews")" asp-controller="Host" asp-action="Reviews"> Reviews</a>
                <a asp-controller="Notifications" asp-action="Index">
                     Notifications
                    @if (unread > 0) { <span class="badge">@unread</span> }
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="logout"> Logout</button>
                </form>
            </nav>
        </aside>

        <div class="content">
            <div class="topbar">
                <h1>@ViewData["Title"]</h1>
                <div class="right">
                    <a class="icon" asp-controller="Notifications" asp-action="Index">
                        &#128276;
                        @if (unread > 0) { <span class="badge">@unread</span> }
                    </a>
                    <div class="profile">
                        <div class="avatar">@initial</div>
                        <div>@fullName<small>Host</small></div>
                    </div>
                </div>
            </div>
            <main>
                @RenderBody()
            </main>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
