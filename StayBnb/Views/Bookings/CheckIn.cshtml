@model CheckInViewModel
@{
    ViewData["Title"] = "Check in - " + Model.Property!.Title;
    var property = Model.Property!;
    var image = property.Images.FirstOrDefault();
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<style>
    .checkin { display: flex; flex-wrap: wrap; gap: 2rem; justify-content: center; align-items: flex-start; }
    .checkin .card {
        flex: 1 1 380px;
        max-width: 480px;
        background: #fff;
        border-radius: 7px;
        box-shadow: 0 5px 10px rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }
    .card .body { padding: 2rem; }
    .card header { font-size: 2rem; font-weight: 500; text-align: center; margin-bottom: 1.5rem; }
    .card img { width: 100%; height: 260px; object-fit: cover; display: block; }
    .card h2 { margin: 0 0 .3rem; font-weight: 500; }
    .card .location { color: #666; margin: 0 0 1rem; }
    .card .price { font-size: 1.3rem; margin-bottom: 1.2rem; }
    .card .price small { color: #666; font-size: 1rem; }
    .card h4 { margin: 1.2rem 0 .6rem; font-weight: 500; }
    .amenities { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
    .amenities li { background: #f5f5f5; border-radius: 999px; padding: .35rem .9rem; font-size: 14px; }
    .fees { width: 100%; font-size: 15px; border-collapse: collapse; margin-top: .4rem; }
    .fees td { padding: .25rem 0; }
    .fees td:last-child { text-align: right; }

    .checkin label { display: block; font-size: 14px; color: #444; margin-bottom: .3rem; }
    .checkin form input:not([type=submit]):not([type=hidden]),
    .checkin form select {
        height: 60px;
        width: 100%;
        padding: 0 15px;
        font-size: 17px;
        margin-bottom: 1.3rem;
        border: 1px solid #ddd;
        border-radius: 6px;
        outline: none;
        background: #fff;
        font-family: inherit;
    }
    .checkin form input[type=file] { padding: 15px; height: auto; }
    .checkin form input:focus, .checkin form select:focus { box-shadow: 0 1px 0 rgba(0, 0, 0, 0.2); }
    .checkin form .row { display: flex; gap: 1rem; }
    .checkin form .row > div { flex: 1; }
    .checkin form input.button {
        height: 60px;
        width: 100%;
        border: none;
        border-radius: 6px;
        color: #fff;
        background: #FF385C;
        font-size: 1.2rem;
        font-weight: 500;
        letter-spacing: 1px;
        margin-top: 1rem;
        cursor: pointer;
    }
    .checkin .error, .checkin .field-validation-error { color: #c00; font-size: 14px; }
    .checkin .field-validation-error { display: block; margin: -1rem 0 1rem; }
    .checkin .note { font-size: 13px; color: #666; margin: -.8rem 0 1rem; }
</style>

<div class="checkin">
    <div class="card">
        @if (image != null)
        {
            <img src="@image.ImageUrl" alt="@property.Title" />
        }
        <div class="body">
            <h2>@property.Title</h2>
            <p class="location">@property.City - @property.Address</p>
            <div class="price"><strong>@property.PricePerNight.ToString("C")</strong> <small>/ night</small></div>

            <h4>Amenities</h4>
            @if (property.Amenities.Any())
            {
                <ul class="amenities">
                    @foreach (var amenity in property.Amenities)
                    {
                        <li>@amenity.Name</li>
                    }
                </ul>
            }
            else
            {
                <p class="location">No amenities listed.</p>
            }

            <h4>Fees</h4>
            <table class="fees">
                <tr><td>Cleaning fee</td><td>@property.CleaningFee.ToString("C")</td></tr>
                <tr><td>Service fee</td><td>@property.ServiceFee.ToString("C")</td></tr>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="body">
            <header>Check in</header>
            <form asp-action="CheckIn" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="PropertyId" />
                <div class="error" asp-validation-summary="ModelOnly"></div>

                <div class="row">
                    <div>
                        <label asp-for="CheckInDate"></label>
                        <input asp-for="CheckInDate" type="date" min="@today" />
                        <span asp-validation-for="CheckInDate" class="field-validation-error"></span>
                    </div>
                    <div>
                        <label asp-for="CheckOutDate"></label>
                        <input asp-for="CheckOutDate" type="date" min="@today" />
                        <span asp-validation-for="CheckOutDate" class="field-validation-error"></span>
                    </div>
                </div>

                <label asp-for="NumberOfGuests"></label>
                <input asp-for="NumberOfGuests" type="number" min="1" max="50" />
                <span asp-validation-for="NumberOfGuests" class="field-validation-error"></span>

                <label asp-for="DocumentType"></label>
                <select asp-for="DocumentType">
                    <option value="">Select a document</option>
                    <option value="ID">ID</option>
                    <option value="Passport">Passport</option>
                </select>
                <span asp-validation-for="DocumentType" class="field-validation-error"></span>

                <label asp-for="Document"></label>
                <input asp-for="Document" type="file" accept=".pdf,.jpg,.jpeg,.png" />
                <div class="note">PDF, JPG or PNG, up to 5 MB. Your host will verify this.</div>
                <span asp-validation-for="Document" class="field-validation-error"></span>

                <input type="submit" class="button" value="Submit check-in" />
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
