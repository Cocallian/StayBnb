@model List<StayBnb.Models.Message>
@{
    ViewData["Title"] = "Messages";
}

<table>
    <thead>
        <tr>
            <th>From</th>
            <th>To</th>
            <th>Message</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@($"{m.Sender?.FirstName} {m.Sender?.LastName}".Trim())</td>
                <td>@($"{m.Receiver?.FirstName} {m.Receiver?.LastName}".Trim())</td>
                <td>@m.Content</td>
                <td>@m.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
            </tr>
        }
    </tbody>
</table>
